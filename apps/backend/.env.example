# Database (Recommended Free Tier: https://supabase.com or https://neon.tech)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photo_studio_saas?schema=public"

# Application Settings
NODE_ENV=development
PORT=3000

# JWT Secret
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Free Tier: https://upstash.com)
REDIS_URL=redis://localhost:6379

# Cloudinary (Free Tier: https://cloudinary.com)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Resend Email (Free Tier: https://resend.com)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Twilio WhatsApp (Optional)
TWILIO_SID=your-twilio-sid
TWILIO_TOKEN=your-twilio-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Sentry Errors (Free Tier: https://sentry.io)
SENTRY_DSN=your-sentry-dsn

# PostHog Analytics (Free Tier: https://posthog.com)
POSTHOG_API_KEY=your-posthog-api-key
