# =============================================================================
# ReviewsFeedback SaaS - Backend Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

# Database (Neon - recommended free tier: https://neon.tech)
# Format: postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Application Settings
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# JWT Secrets (generate with: openssl rand -hex 64)
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (local or Upstash)
REDIS_URL=redis://localhost:6379

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Cloudinary (Legacy - recommended for dynamic transformations)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Cloudflare R2 / AWS S3 (https://dash.cloudflare.com/)
# Recommended for large-scale image storage and zero-egress fees
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_ENDPOINT=https://account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your_id.r2.dev or your custom domain

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Twilio (WhatsApp notifications - optional)
TWILIO_SID=your-twilio-sid
TWILIO_TOKEN=your-twilio-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Sentry (Error Tracking - optional)
SENTRY_DSN=your-sentry-dsn

# PostHog (Product Analytics - optional)
POSTHOG_API_KEY=your-posthog-api-key
