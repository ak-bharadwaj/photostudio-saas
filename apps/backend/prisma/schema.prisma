generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

model Studio {
  id                    String           @id @default(uuid())
  name                  String
  slug                  String           @unique
  email                 String           @unique
  phone                 String
  logoUrl               String?          @map("logo_url")
  brandingConfig        Json?            @map("branding_config")
  subscriptionTier      SubscriptionTier @default(PRO) @map("subscription_tier")
  subscriptionExpiresAt DateTime?        @map("subscription_expires_at")
  status                StudioStatus     @default(ACTIVE)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  billingModel          BillingModel     @default(SUBSCRIPTION) @map("billing_model")
  commissionRate        Decimal?         @map("commission_rate") @db.Decimal(10, 2)
  commissionType        CommissionType?  @default(PERCENTAGE) @map("commission_type")
  currency              String           @default("INR")
  defaultTerms          String?          @map("default_terms")
  taxRate               Decimal?         @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  address               String?
  city                  String?
  state                 String?
  zipCode               String?          @map("zip_code")
  website               String?
  description           String?
  isPublic              Boolean          @default(true) @map("is_public")
  hotDeal               String?          @map("hot_deal")
  isRecommended         Boolean          @default(false) @map("is_recommended")
  bookings              Booking[]
  commissions           Commission[]
  customers             Customer[]
  invoices              Invoice[]
  portfolioItems        PortfolioItem[]
  reviews               Review[]
  services              Service[]
  users                 User[]
  workflows             Workflow[]

  @@index([slug])
  @@index([status])
  @@index([name])
  @@index([createdAt])
  @@map("studios")
}

model Commission {
  id        String           @id @default(uuid())
  studioId  String           @map("studio_id")
  bookingId String?          @map("booking_id")
  invoiceId String           @map("invoice_id")
  amount    Decimal          @db.Decimal(10, 2)
  status    CommissionStatus @default(PENDING)
  notes     String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  booking   Booking?         @relation(fields: [bookingId], references: [id])
  invoice   Invoice          @relation(fields: [invoiceId], references: [id])
  studio    Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([invoiceId])
  @@index([status])
  @@map("commissions")
}

model StudioRequest {
  id         String              @id @default(uuid())
  studioName String              @map("studio_name")
  ownerName  String              @map("owner_name")
  email      String
  phone      String?
  city       String?
  status     StudioRequestStatus @default(PENDING)
  notes      String?
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@map("studio_requests")
}

model User {
  id           String     @id @default(uuid())
  studioId     String?    @map("studio_id")
  email        String?    @unique
  phone        String?    @unique
  passwordHash String?    @map("password_hash")
  name         String
  role         UserRole   @default(PHOTOGRAPHER)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  provider     String     @default("local")
  providerId   String?    @map("provider_id")
  bookings     Booking[]  @relation("AssignedBookings")
  customers    Customer[]
  studio       Studio?    @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([email])
  @@index([phone])
  @@map("users")
}

model Customer {
  id           String    @id @default(uuid())
  studioId     String    @map("studio_id")
  name         String
  email        String?
  phone        String
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  globalUserId String?   @map("global_user_id")
  bookings     Booking[]
  globalUser   User?     @relation(fields: [globalUserId], references: [id])
  studio       Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  reviews      Review[]

  @@unique([studioId, phone])
  @@unique([studioId, email])
  @@index([studioId])
  @@index([email])
  @@index([createdAt])
  @@index([studioId, name])
  @@map("customers")
}

model Service {
  id              String    @id @default(uuid())
  studioId        String    @map("studio_id")
  name            String
  description     String?
  price           Decimal   @db.Decimal(10, 2)
  durationMinutes Int       @map("duration_minutes")
  isActive        Boolean   @default(true) @map("is_active")
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  coverImage      String?   @map("cover_image")
  occasion        String?
  categoryId      String?   @map("category_id")
  bookings        Booking[]
  category        Category? @relation(fields: [categoryId], references: [id])
  studio          Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([isActive])
  @@index([studioId, isActive])
  @@map("services")
}

model Booking {
  id                  String             @id @default(uuid())
  studioId            String             @map("studio_id")
  customerId          String             @map("customer_id")
  serviceId           String             @map("service_id")
  assignedToUserId    String?            @map("assigned_to_user_id")
  scheduledAt         DateTime           @map("scheduled_at")
  status              BookingStatus      @default(INQUIRY)
  customerNotes       String?            @map("customer_notes")
  internalNotes       String?            @map("internal_notes")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  acceptedTerms       Boolean            @default(false) @map("accepted_terms")
  contractUrl         String?            @map("contract_url")
  quoteAcceptedAt     DateTime?          @map("quote_accepted_at")
  quoteAmount         Decimal?           @map("quote_amount") @db.Decimal(10, 2)
  quoteNotes          String?            @map("quote_notes")
  negotiationRounds    Int                @default(0) @map("negotiation_rounds")
  quotedAt            DateTime?          @map("quoted_at")
  quoteRejectionNotes String?            @map("quote_rejection_notes")
  statusLogs          BookingStatusLog[]
  assignedTo          User?              @relation("AssignedBookings", fields: [assignedToUserId], references: [id])
  customer            Customer           @relation(fields: [customerId], references: [id])
  service             Service            @relation(fields: [serviceId], references: [id])
  studio              Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  commissions         Commission[]
  invoices            Invoice[]
  review              Review?

  @@index([studioId])
  @@index([customerId])
  @@index([scheduledAt])
  @@index([status])
  @@index([createdAt])
  @@index([studioId, status])
  @@index([studioId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([studioId, customerId])
  @@index([studioId, createdAt])
  @@map("bookings")
}

model BookingStatusLog {
  id        String        @id @default(uuid())
  bookingId String        @map("booking_id")
  status    BookingStatus
  notes     String?
  createdAt DateTime      @default(now()) @map("created_at")
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_status_logs")
}

model Invoice {
  id            String        @id @default(uuid())
  studioId      String        @map("studio_id")
  bookingId     String?       @map("booking_id")
  customerId    String        @map("customer_id")
  invoiceNumber String        @unique @map("invoice_number")
  lineItems     Json
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?     @map("due_date")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  commissions   Commission[]
  booking       Booking?      @relation(fields: [bookingId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  studio        Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([studioId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([createdAt])
  @@index([dueDate])
  @@index([studioId, status])
  @@index([status, dueDate])
  @@map("invoices")
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String        @map("invoice_id")
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  transactionId String?       @map("transaction_id")
  notes         String?
  paidAt        DateTime      @default(now()) @map("paid_at")
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paidAt])
  @@map("payments")
}

model PortfolioItem {
  id          String   @id @default(uuid())
  studioId    String   @map("studio_id")
  title       String
  description String?
  imageUrl    String   @map("image_url")
  category    String?
  sortOrder   Int      @default(0) @map("sort_order")
  isVisible   Boolean  @default(true) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at")
  studio      Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([isVisible])
  @@index([category])
  @@index([studioId, isVisible])
  @@map("portfolio_items")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  imageUrl  String?   @map("image_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  services  Service[]

  @@map("categories")
}

model Review {
  id         String   @id @default(uuid())
  studioId   String   @map("studio_id")
  customerId String   @map("customer_id")
  bookingId  String?  @unique @map("booking_id")
  rating     Int      @default(5)
  comment    String?
  reply      String?
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer   Customer @relation(fields: [customerId], references: [id])
  studio     Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([customerId])
  @@map("reviews")
}

model Workflow {
  id        String   @id @default(uuid())
  studioId  String   @map("studio_id")
  name      String
  trigger   String
  actions   Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("workflows")
}

enum StudioRequestStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum BillingModel {
  SUBSCRIPTION
  COMMISSION
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  STUDIO
  ENTERPRISE
  PRO
}

enum StudioStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  TRIAL
}

enum CommissionStatus {
  PENDING
  COLLECTED
  CANCELLED
}

enum UserRole {
  OWNER
  PHOTOGRAPHER
  ASSISTANT
  CUSTOMER
}

enum BookingStatus {
  INQUIRY
  QUOTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  OTHER
}
